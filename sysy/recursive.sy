/* ============================================================
 * Q2/Q3 【可选】程序三：递归（recursive.sy）
 * ------------------------------------------------------------
 * 覆盖：递归（函数调用自身）、多层调用、栈帧嵌套
 * 算术：* -
 * 运行时库 getint / putint / putch
 *
 * LLVM IR 研究重点：递归函数的 call 自身、递归控制流
 * RISC-V 研究重点：栈帧建立/恢复、sp/ra 保存恢复、
 *                  递归调用约定、参数传递（两位学长都没做的亮点）
 *
 * 测试用例（对拍）：
 *   输入 5 → 输出 120
 * ============================================================ */

int factorial(int n) {
    if (n <= 1)
        return 1;
    return n * factorial(n - 1);   /* * - 递归调用 */
}

int main() {
    int n = getint();
    putint(factorial(n));
    putch(10);
    return 0;
}
