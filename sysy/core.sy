/* ============================================================
 * Q2/Q3 程序一：核心综合程序（core.sy）
 * ------------------------------------------------------------
 * 参考 Mercycoffee 学长思路：relu 极简函数 + 全运算 + 数组 + 循环
 * 一个程序覆盖：函数、if-else、while+break、数组、+ - * / %、
 *               关系运算 < > <= == >=、逻辑运算 && || !、
 *               常量/全局变量、运行时库 getint/putint/putch
 *
 * 测试用例（对拍）：
 *   输入 0   → 输出 0 0（两行）
 *   输入 5   → 输出 5 与 sum（两行）
 *   输入 10  → 输出 10 与 sum（两行）
 *   输入 -1/11 → 无输出（return 1）
 * ============================================================ */

const int MAX_N = 10;

int call_count = 0;            /* 全局变量 */

int relu(int n) {              /* 函数：带参、返回值、if 分支 */
    call_count = call_count + 1;
    if (n <= 0) {              /* <= 关系运算 + if-else */
        return 0;
    }
    return n;
}

int main() {
    int n, result, i, sum;
    int arr[11];               /* 数组 */

    n = getint();

    /* 边界检查：< > || 逻辑或 */
    if (n < 0 || n > MAX_N) {
        return 1;
    }

    /* 逻辑与 && 和 非 ! */
    if (n >= 0 && !(n == 0)) {  /* >= == && ! */
        result = relu(n);       /* 函数调用 */
    } else {
        result = 0;
    }

    putint(result);
    putch(10);

    /* 循环 + break + 数组 + 全算术运算 */
    sum = 0;
    i = 0;
    while (i <= n) {            /* <= */
        if (i == 8)             /* == 和 break */
            break;
        arr[i] = relu(i);       /* 数组赋值 + 函数调用 */
        sum = sum + arr[i] * 2 - i / 3 % 5;   /* + * - / % 全有 */
        i = i + 1;
    }
    putint(sum);
    putch(10);

    return 0;
}
